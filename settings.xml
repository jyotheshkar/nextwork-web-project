<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional: set both variables before using -s settings.xml.
     Normal local builds and buildspec.yml do not use this file. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>nextwork-codeartifact</id>
      <username>aws</username>
      <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>nextwork-codeartifact</id>
      <name>Explicitly configured optional private mirror</name>
      <url>${env.CODEARTIFACT_MAVEN_URL}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
